{
  "name": "qwen-user-agent",
  "version": "0.5.0",
  "private": true,
  "description": "Persona UX research agent: compare apps as a demographic user and produce evidence-backed feedback",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/agent.js",
    "runner": "node --env-file=.env src/runner.js",
    "enqueue": "node --env-file=.env src/runner.js enqueue",
    "process": "node --env-file=.env src/runner.js process",
    "eval": "node --env-file=.env src/eval.js",
    "postinstall": "playwright install chromium",
    "worker": "node --env-file=.env src/worker.js",
    "web": "npm --prefix web run dev",
    "web:install": "npm --prefix web install",
    "prompts:compare": "node --env-file=.env src/prompts-compare.js",
    "worker:pool": "WORKER_CONCURRENCY=2 node --env-file=.env src/worker.js",
    "compare": "node --env-file=.env src/compare.js",
    "feedback": "node --env-file=.env src/feedback.js"
  },
  "dependencies": {
    "openai": "^4.77.0",
    "playwright": "^1.49.0",
    "sql.js": "^1.12.0",
    "better-sqlite3": "^11.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "pg": "^8.13.0"
  }
}
