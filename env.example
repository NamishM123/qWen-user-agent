# Point at local Ollama (default) or swap for OpenRouter.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# Vision recovery model (Phase 1). Pull with: ollama pull qwen2.5vl:7b
LLM_VISION_MODEL=qwen2.5vl:7b

# Structured output: prefer OpenAI-style json_schema when the endpoint supports it.
# Set to 0 to skip json_schema and use json_object + schema-in-prompt + code validation.
# LLM_JSON_SCHEMA=0

# OpenRouter hosted fallback (same OpenAI SDK path):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=qwen/qwen-2.5-7b-instruct:free

# HEADLESS=1 runs Chromium without a window (CI / eval / worker).
# HEADLESS=1

# Optional cap on agent loop steps (default 25).
# MAX_STEPS=25

# --- Phase 3: Auth ---
# Dev/local auth (default). Works with no GitHub secrets.
AUTH_DEV_USER=dev@local
AUTH_SECRET=dev-insecure-change-me
# AUTH_DEV_OPEN=1  # allow any email via Dev login

# GitHub OAuth (Auth.js / NextAuth) for multi-user:
# AUTH_GITHUB_ID=...
# AUTH_GITHUB_SECRET=...
# AUTH_URL=http://localhost:3000

# --- Phase 3: Storage ---
# Prefer Postgres when set (Neon-ready). Otherwise SQLite at data/tasks.db.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Optional object storage stubs (screenshots stay in local runs/ for now):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# Worker
# WORKER_POLL_MS=1500
# WORKER_HEADLESS=1

# --- Phase 4: Concurrency ---
# WORKER_CONCURRENCY=2

# --- Phase 4: Guardrails ---
# MAX_STEPS=25
# MAX_LATENCY_MS=120000
# MAX_TOKENS_PER_TASK=50000
# MAX_COST_USD=0.05
# COST_PER_1K_TOKENS=0
# RATE_LIMIT_TASKS_PER_HOUR=30

# --- Phase 4: Prompt A/B ---
# PROMPT_VERSION=v1.1
